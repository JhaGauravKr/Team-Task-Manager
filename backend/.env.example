# PostgreSQL connection string (Railway auto-injects this when you add a Postgres plugin)
DATABASE_URL="postgresql://user:password@localhost:5432/taskmanager"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="replace_with_a_long_random_secret"

# Port the server listens on (Railway sets this automatically)
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN="http://localhost:5173"
